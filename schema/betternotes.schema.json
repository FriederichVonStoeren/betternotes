{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friederichvonstoeren.github.io/betternotes/schema/betternotes.schema.json",
  "title": "betternotes file (format version 1.x)",
  "description": "Covers notebook.json, page files and OCR sidecars. Unknown fields and unknown object types are allowed everywhere on purpose: see docs/FORMAT.md, section 3. Released under CC0.",
  "type": "object",
  "required": ["format", "formatVersion"],
  "properties": {
    "format": { "enum": ["betternotes.notebook", "betternotes.page", "betternotes.ocr"] },
    "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "betternotes.notebook" } } },
      "then": { "$ref": "#/$defs/notebook" }
    },
    {
      "if": { "properties": { "format": { "const": "betternotes.page" } } },
      "then": { "$ref": "#/$defs/page" }
    },
    {
      "if": { "properties": { "format": { "const": "betternotes.ocr" } } },
      "then": { "$ref": "#/$defs/ocr" }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "color": { "type": "string", "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$" },
    "asset": { "type": "string", "pattern": "^[0-9a-f]{64}\\.[a-z0-9]{1,8}$" },
    "fraction": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "length": { "type": "integer", "minimum": 0 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "ints": { "type": "array", "items": { "type": "integer" } },

    "notebook": {
      "required": ["id", "title", "created", "modified", "chapters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "created": { "$ref": "#/$defs/time" },
        "modified": { "$ref": "#/$defs/time" },
        "tags": { "$ref": "#/$defs/tags" },
        "cover": {
          "type": "object",
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "asset": { "$ref": "#/$defs/asset" }
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "order"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string" },
              "order": { "type": "integer" }
            }
          }
        }
      }
    },

    "page": {
      "required": ["id", "chapter", "order", "created", "modified", "size", "layers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "chapter": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "order": { "type": "integer" },
        "title": { "type": "string" },
        "created": { "$ref": "#/$defs/time" },
        "modified": { "$ref": "#/$defs/time" },
        "tags": { "$ref": "#/$defs/tags" },
        "size": {
          "type": "object",
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "integer", "minimum": 1 },
            "h": { "type": "integer", "minimum": 1 }
          }
        },
        "paper": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "color": { "$ref": "#/$defs/color" },
            "lineColor": { "$ref": "#/$defs/color" },
            "spacing": { "type": "integer", "minimum": 1 }
          }
        },
        "mirror": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string" },
            "cx": { "type": "integer" },
            "cy": { "type": "integer" },
            "count": { "type": "integer", "minimum": 2 }
          }
        },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
      }
    },

    "layer": {
      "type": "object",
      "required": ["id", "name", "visible", "locked", "objects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/fraction" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } }
      }
    },

    "object": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "link": { "type": "string" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "$ref": "#/$defs/length" },
        "h": { "$ref": "#/$defs/length" },
        "rotation": { "type": "integer" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "stroke" } } },
          "then": { "$ref": "#/$defs/stroke" }
        },
        {
          "if": { "properties": { "type": { "const": "shape" } } },
          "then": { "$ref": "#/$defs/shape" }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "$ref": "#/$defs/text" }
        },
        {
          "if": { "properties": { "type": { "const": "image" } } },
          "then": { "$ref": "#/$defs/image" }
        },
        {
          "if": { "properties": { "type": { "const": "pdf" } } },
          "then": { "$ref": "#/$defs/pdf" }
        }
      ]
    },

    "stroke": {
      "description": "Not expressible here: every array in pts has the same length as pts.x.",
      "required": ["tool", "color", "width", "pts"],
      "properties": {
        "tool": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "width": { "$ref": "#/$defs/length" },
        "pts": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "$ref": "#/$defs/ints", "minItems": 1 },
            "y": { "$ref": "#/$defs/ints", "minItems": 1 },
            "p": { "$ref": "#/$defs/ints" },
            "tilt": { "$ref": "#/$defs/ints" },
            "az": { "$ref": "#/$defs/ints" },
            "roll": { "$ref": "#/$defs/ints" },
            "t": { "$ref": "#/$defs/ints" }
          }
        }
      }
    },

    "shape": {
      "description": "Not expressible here: points has an even number of entries.",
      "required": ["shape"],
      "properties": {
        "shape": { "type": "string" },
        "points": { "$ref": "#/$defs/ints", "minItems": 4 },
        "radius": { "$ref": "#/$defs/length" },
        "stroke": {
          "type": "object",
          "required": ["color", "width"],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "$ref": "#/$defs/length" },
            "dash": { "$ref": "#/$defs/ints" }
          }
        },
        "fill": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "from": { "$ref": "#/$defs/attachment" },
        "to": { "$ref": "#/$defs/attachment" }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "enum": ["rect", "roundRect", "ellipse", "triangle"] } } },
          "then": { "required": ["x", "y", "w", "h"] }
        },
        {
          "if": { "properties": { "shape": { "enum": ["line", "arrow", "polygon", "curve", "connector"] } } },
          "then": { "required": ["points"] }
        }
      ]
    },

    "attachment": {
      "type": "object",
      "required": ["object", "anchor"],
      "properties": {
        "object": { "$ref": "#/$defs/id" },
        "anchor": { "type": "string" }
      }
    },

    "text": {
      "required": ["x", "y", "w", "markdown"],
      "properties": {
        "markdown": { "type": "string" },
        "fontSize": { "type": "integer", "minimum": 1 },
        "color": { "$ref": "#/$defs/color" }
      }
    },

    "image": {
      "required": ["asset", "x", "y", "w", "h"],
      "properties": { "asset": { "$ref": "#/$defs/asset" } }
    },

    "pdf": {
      "required": ["asset", "page", "x", "y", "w", "h"],
      "properties": {
        "asset": { "$ref": "#/$defs/asset" },
        "page": { "type": "integer", "minimum": 1 }
      }
    },

    "ocr": {
      "required": ["page", "pageModified", "items"],
      "properties": {
        "page": { "$ref": "#/$defs/id" },
        "pageModified": { "$ref": "#/$defs/time" },
        "engine": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "x", "y", "w", "h"],
            "properties": {
              "text": { "type": "string" },
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "$ref": "#/$defs/length" },
              "h": { "$ref": "#/$defs/length" },
              "confidence": { "$ref": "#/$defs/fraction" }
            }
          }
        }
      }
    }
  }
}
